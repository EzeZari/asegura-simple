generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// --- ITERACIÓN 1: CORE (Gestión de Pólizas y Asegurados) ---

model Productor {
  id               Int      @id @default(autoincrement())
  nombre           String
  apellido         String
  email            String   @unique
  telefono         String?
  usuario          String   @unique
  contrasenaHash   String
  fechaAlta        DateTime @default(now())

  // Conexión con el sistema de autenticación
  userId           Int?     @unique
  user             User?    @relation(fields: [userId], references: [id])

  polizas            Poliza[]
  siniestros         Siniestro[]

  asegurados         Asegurado[]
  companias          Compania[] 
  notasSiniestro     NotaSiniestro[]
  historialSiniestro HistorialSiniestro[]
  alertas            Alerta[]

  envioAutomaticoActivo  Boolean  @default(false)
  horaEnvioAutomatico    String   @default("09:00")
  diasAvisoAutomatico    Int      @default(15)

  actividades        Actividad[] 
}

model Asegurado {
  id              Int       @id @default(autoincrement())
  nombre          String    // Nombre o Razón Social
  apellido        String?   // Opcional por si es empresa
  tipo            String    @default("Individuo") 
  dni             String    
  fechaNacimiento DateTime?
  condicionIva    String    @default("Consumidor Final")
  email           String?
  telefono        String?
  direccion       String?
  codigoPostal    String?
  activo          Boolean   @default(true)
  fechaRegistro   DateTime  @default(now())
  
  productorId     Int
  productor       Productor @relation(fields: [productorId], references: [id])

  polizas         Poliza[]

  @@unique([productorId, dni]) 
}

model Compania {
  id                 Int      @id @default(autoincrement())
  nombre             String
  cuit               String?  
  telefonoSiniestros String?  
  email              String?

  productorId        Int        
  productor          Productor  @relation(fields: [productorId], references: [id]) 

  polizas            Poliza[]
}

model Poliza {
  id               Int      @id @default(autoincrement())
  nroPoliza        String   
  tipoPoliza       String
  fechaInicio      DateTime
  fechaVencimiento DateTime
  estado           String
  cobertura        String?
  formaPago        String?   

  aseguradoId      Int
  asegurado        Asegurado @relation(fields: [aseguradoId], references: [id])
  
  companiaId       Int
  compania         Compania  @relation(fields: [companiaId], references: [id])

  productorId      Int
  productor        Productor @relation(fields: [productorId], references: [id])

  siniestros       Siniestro[]
  alertas          Alerta[]
  actividades      Actividad[] 

  // --- DATOS DEL VEHÍCULO Y COBERTURA ---
  patente           String?
  marca             String?
  modelo            String?
  // 🔥 NUEVOS CAMPOS OPCIONALES
  motor             String?
  chasis            String?
  anio              String?
  color             String?
  sumaAsegurada     String?
  clausulaAjuste    String?

  ubicacionRiesgo   String?
  cantidadEmpleados String?

  ultimoAviso DateTime?

  pdfUrl        String?

  cuponeraUrl    String?
  enviarCuponera Boolean  @default(false)

  estadoCuotas   Json?

  avisoGestionado    Boolean  @default(false)
  observacionesAviso String?  @db.Text

  @@unique([productorId, nroPoliza]) 
}

model Alerta {
  id              Int      @id @default(autoincrement())
  mensaje         String
  fechaGeneracion DateTime @default(now())
  
  polizaId        Int
  poliza          Poliza   @relation(fields: [polizaId], references: [id])

  productorId     Int
  productor       Productor @relation(fields: [productorId], references: [id])
}

// --- ITERACIÓN 2: GESTIÓN DE SINIESTROS ---

model Siniestro {
  id                 Int      @id @default(autoincrement())
  nroSiniestro       String   
  fechaHecho         DateTime
  descripcionInicial String
  estadoSiniestro    String
  fechaCreacion      DateTime @default(now())
  fechaCierre        DateTime?

  polizaId           Int
  poliza             Poliza   @relation(fields: [polizaId], references: [id])

  productorId        Int
  productor          Productor @relation(fields: [productorId], references: [id])

  notas          NotaSiniestro[]
  historial      HistorialSiniestro[]
  linksConsulta  LinkConsulta[]
  notificaciones Notificacion[]

  @@unique([productorId, nroSiniestro]) 
}

model NotaSiniestro {
  id          Int      @id @default(autoincrement())
  texto       String
  fecha       DateTime @default(now())
  publico     Boolean  @default(false)

  siniestroId Int
  siniestro   Siniestro @relation(fields: [siniestroId], references: [id])
  
  productorId Int
  productor   Productor @relation(fields: [productorId], references: [id])
}

model HistorialSiniestro {
  id             Int      @id @default(autoincrement())
  estadoAnterior String
  estadoNuevo    String
  fechaCambio    DateTime @default(now())
  comentario     String?

  siniestroId    Int
  siniestro      Siniestro @relation(fields: [siniestroId], references: [id])
  
  productorId    Int
  productor      Productor @relation(fields: [productorId], references: [id])
}

model LinkConsulta {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  url         String?
  creadoEn    DateTime @default(now())
  expiracion  DateTime
  activo      Boolean  @default(true)

  siniestroId Int
  siniestro   Siniestro @relation(fields: [siniestroId], references: [id])
}

model Notificacion {
  id           Int      @id @default(autoincrement())
  canal        String
  destinatario String
  motivo       String
  mensaje      String
  enviadaEn    DateTime @default(now())
  estadoEnvio  String

  siniestroId  Int
  siniestro    Siniestro @relation(fields: [siniestroId], references: [id])
}

enum Role {
  ADMIN
  PRODUCTOR
  VIEWER
}

model User {
  id                   Int      @id @default(autoincrement())
  nombre               String
  email                String   @unique
  telefono             String
  password             String
  role                 Role     @default(PRODUCTOR) 
  createdAt            DateTime @default(now())

  ultimoLogin          DateTime?

  resetPasswordToken   String?  
  resetPasswordExpires DateTime? 
  twoFactorEnabled     Boolean @default(false)

  codigoVerificacion   String?  
  emailPendiente       String?  

  isVerified           Boolean  @default(false)
  verificationToken    String?  @unique

  plan                 Plan          @default(GRATUITO) 
  suscripcion          Suscripcion?
  productor            Productor?    

  pagos         Pago[]

  jefeId               Int?
  jefe                 User?         @relation("Equipo", fields: [jefeId], references: [id])
  empleados            User[]        @relation("Equipo")
  sugerencias   Sugerencia[]
}

model Actividad {
  id          Int      @id @default(autoincrement())
  accion      String   
  entidad     String   
  descripcion String   
  cliente     String?
  fecha       DateTime @default(now())

  productorId Int?                                                    
  productor   Productor? @relation(fields: [productorId], references: [id])  

  polizaId    Int?
  poliza      Poliza?    @relation(fields: [polizaId], references: [id], onDelete: Cascade)
}

model Agencia {
  id                    Int      @id @default(1)
  nombre                String   @default("AseguraSimple")
  cuit                  String?
  email                 String?
  telefono              String?
  firma                 String?
  logoUrl               String?  
  mensajeVencimiento    String?  @db.Text  
  mensajePolizaCritica  String?  @db.Text  
  mensajePolizaVencida  String?  @db.Text  
  mensajeBienvenida     String?  @db.Text  
  diasAlertaVencimiento Int      @default(30)
  diasAlertaCritica     Int      @default(7)  

  envioAutomaticoActivo Boolean  @default(false) 
  horaEnvioAutomatico   String   @default("09:00") 
  diasAvisoAutomatico   Int      @default(15) 
  
  enviarMailBienvenida  Boolean  @default(true)

  updatedAt             DateTime @updatedAt
  usarFirma             Boolean  @default(false)
}

enum Plan {
  GRATUITO 
  BASICO
  PROFESIONAL
  AGENCIA
}

model Suscripcion {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mpPreapprovalId String?   @unique 
  mpCustomerId    String?   
  estado          String    @default("pendiente") 
  
  fechaInicio      DateTime  @default(now())
  fechaVencimiento DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Pago {
  id              Int      @id @default(autoincrement())
  userId          Int
  mpPagoId        String   @unique 
  monto           Float
  moneda          String   @default("ARS")
  estado          String   
  metodoPago      String?  
  fechaPago       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ComunicadoAdmin {
  id             Int      @id @default(1)
  
  mensajeBanner  String?  @db.Text
  activoBanner   Boolean  @default(false)
  tipoBanner     String   @default("blue")
  
  mensajeModal   String?  @db.Text
  activoModal    Boolean  @default(false)
  tipoModal      String   @default("blue")
  
  updatedAt      DateTime @updatedAt
}

model Sugerencia {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String   @db.Text
  estado      String   @default("Pendiente") 
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Descuento {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  porcentaje  Float    
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}